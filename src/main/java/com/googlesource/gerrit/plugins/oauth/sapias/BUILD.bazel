load("@com_googlesource_gerrit_bazlets//:gerrit_plugin.bzl", "gerrit_plugin")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools/bzl:plugin.bzl", "PLUGIN_DEPS_NEVERLINK")

package(default_visibility = ["//plugins/oauth:visibility"])

java_library(
    name = "sapias",
    srcs = glob(
        ["*.java"],
        exclude = ["*PluginModule.java"],
    ),
    deps = PLUGIN_DEPS_NEVERLINK + [
        "//plugins/oauth:core",
        "@oauth_plugin_deps//:com_sap_cloud_security_env",
        "@oauth_plugin_deps//:com_sap_cloud_security_java_api",
        "@oauth_plugin_deps//:com_sap_cloud_security_java_security",
        "@oauth_plugin_deps//:com_sap_cloud_security_xsuaa_token_client",
    ],
)

gerrit_plugin(
    name = "oauth-sapias",
    srcs = ["SAPIasPluginModule.java"],
    dir_name = "oauth",
    manifest_entries = [
        "Gerrit-PluginName: gerrit-oauth-provider",
        "Gerrit-Module: com.googlesource.gerrit.plugins.oauth.sapias.SAPIasPluginModule",
        "Gerrit-InitStep: com.googlesource.gerrit.plugins.oauth.sapias.SAPIasInitStep",
        "Implementation-Title: Gerrit OAuth authentication provider for sapias",
        "Implementation-URL: https://github.com/davido/gerrit-oauth-provider",
    ],
    resources = ["//plugins/oauth:oauth_resources"],
    deps = [
        ":sapias",
        "//plugins/oauth:core",
    ],
)
